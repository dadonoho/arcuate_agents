# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ElevenLabs
ELEVENLABS_API_KEY=...

# Zoom (Server-to-Server OAuth — marketplace.zoom.us)
ZOOM_ACCOUNT_ID=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...
ZOOM_WEBHOOK_SECRET=...
ZOOM_AUTO_RECORD_INTERNAL=true

# Recall.ai (meeting bot — recall.ai)
RECALL_API_KEY=...

# Google (OAuth credentials JSON path)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Agent config
CHIEF_EMAIL=chief@arcuate.health
FOUNDER_PHONE_NUMBERS=+1...,+1...,+1...,+1...
WEBHOOK_BASE_URL=http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000
